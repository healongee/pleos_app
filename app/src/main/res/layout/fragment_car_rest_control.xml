<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0B111B" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="나만의 휴식 공간" android:textColor="#F5F8FA"
            android:fontFamily="sans-serif-light" android:textSize="30sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:text="차량 안에서 보내는 잠깐의 여유 · 오프라인 콘솔 시연"
            android:textColor="#A8BAC6" android:textSize="14sp" />
        <TextView android:id="@+id/tvRestTimer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:background="@drawable/console_chip" android:padding="12dp"
            android:textColor="#F6CD8A" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
        <com.example.myapplication.ui.VehicleSceneView android:id="@+id/vehicleScene"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="165dp" android:layout_marginTop="16dp"
            android:contentDescription="차량 측면 모의 그림. 창문과 시트 상태는 아래 텍스트에도 표시됩니다." />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStartPreview"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp"
            android:text="로컬 시연 시작" app:cornerRadius="16dp" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="실내 환경" android:textColor="#F5F8FA"
            android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="온도 · 시트 · 창문을 가상으로 조절해 보세요"
            android:textColor="#A8BAC6" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:background="@drawable/console_card"
            android:padding="14dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="좌석 선택 · 4개 좌석 열선/통풍/창문 모의 지원" android:textColor="#A8BAC6" android:textSize="13sp" />
            <RadioGroup android:id="@+id/seatSelector" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <RadioButton android:id="@+id/seatDriver" android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="앞 운전석" android:textColor="#F5F8FA" android:checked="true" />
                <RadioButton android:id="@+id/seatPassenger" android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="앞 동승석" android:textColor="#F5F8FA" />
                <RadioButton android:id="@+id/seatRearLeft" android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="뒤 왼쪽" android:textColor="#F5F8FA" />
                <RadioButton android:id="@+id/seatRearRight" android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="뒤 오른쪽" android:textColor="#F5F8FA" />
            </RadioGroup>
            <TextView android:id="@+id/tvSelectedSeat" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="#58DCE2" android:textSize="16sp"
                android:textStyle="bold" android:accessibilityLiveRegion="polite" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="공조 구역 선택 · 뒷좌석은 공동 구역 시연"
                android:textColor="#A8BAC6" android:textSize="13sp" />
            <RadioGroup android:id="@+id/climateSelector" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton android:id="@+id/zoneDriver" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:text="운전석" android:textColor="#F5F8FA" android:checked="true" />
                <RadioButton android:id="@+id/zonePassenger" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:text="동승석" android:textColor="#F5F8FA" />
                <RadioButton android:id="@+id/zoneRear" android:layout_width="wrap_content" android:layout_height="48dp"
                    android:text="뒷좌석" android:textColor="#F5F8FA" />
            </RadioGroup>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="공조 온도  /  시뮬레이션" android:textColor="#A8BAC6" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnTempMinus"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="56dp" android:layout_height="56dp" android:text="−"
                    android:contentDescription="모의 온도 낮추기" app:cornerRadius="14dp" />
                <TextView android:id="@+id/tvCurrentTemp" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                    android:textColor="#F5F8FA" android:textSize="23sp" android:accessibilityLiveRegion="polite" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnTempPlus"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="56dp" android:layout_height="56dp" android:text="+"
                    android:contentDescription="모의 온도 높이기" app:cornerRadius="14dp" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="시트 모드" android:textColor="#A8BAC6" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSeatHeating"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                    android:minWidth="0dp" android:insetLeft="0dp" android:insetRight="0dp"
                    android:text="열선 꺼짐" android:textSize="12sp" app:cornerRadius="14dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnSeatVentilation"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                    android:minWidth="0dp" android:insetLeft="0dp" android:insetRight="0dp"
                    android:text="통풍 꺼짐" android:textSize="12sp" app:cornerRadius="14dp" />
            </LinearLayout>
            <TextView android:id="@+id/tvSeatPosition" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="14dp" android:textColor="#F5F8FA" android:textSize="15sp"
                android:accessibilityLiveRegion="polite" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="앞좌석 등받이 각도 · 90–130°" android:textColor="#A8BAC6" android:textSize="13sp" />
            <SeekBar android:id="@+id/seekRecline" android:layout_width="match_parent" android:layout_height="48dp"
                android:max="40" android:contentDescription="선택한 앞좌석 모의 등받이 각도, 90에서 130도" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="앞좌석 앞뒤 위치 · 0–100%" android:textColor="#A8BAC6" android:textSize="13sp" />
            <SeekBar android:id="@+id/seekForeAft" android:layout_width="match_parent" android:layout_height="48dp"
                android:max="100" android:contentDescription="선택한 앞좌석 모의 앞뒤 위치, 0에서 100 퍼센트" />
            <TextView android:id="@+id/tvWindowStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:textColor="#F5F8FA" android:textSize="15sp" android:accessibilityLiveRegion="polite" />
            <SeekBar android:id="@+id/seekWindow" android:layout_width="match_parent"
                android:layout_height="48dp" android:max="100" android:progressTint="#58DCE2"
                android:thumbTint="#58DCE2" android:progressBackgroundTint="#496171"
                android:contentDescription="모의 창문 열림 정도, 0에서 100 퍼센트" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="휴식 콘텐츠" android:textColor="#F5F8FA"
            android:textSize="20sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="영상 서비스는 이 차량에서 주차 여부를 확인할 수 없습니다"
            android:textColor="#A8BAC6" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="vertical"
            android:background="@drawable/console_card" android:padding="14dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnMedia"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent" android:layout_height="56dp"
                android:text="앰비언트 모의 재생" app:cornerRadius="14dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="화면 효과만 변경 · 실제 오디오/영상 재생 없음"
                android:textColor="#A8BAC6" android:textSize="12sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnYouTube"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp"
                    android:minWidth="0dp" android:insetLeft="0dp" android:insetRight="0dp"
                    android:text="▶  YouTube" android:textAllCaps="false" android:textSize="15sp"
                    app:cornerRadius="14dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnNetflix"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp"
                    android:minWidth="0dp" android:insetLeft="0dp" android:insetRight="0dp"
                    android:text="N  Netflix" android:textAllCaps="false" android:textSize="15sp"
                    app:cornerRadius="14dp" />
            </LinearLayout>
            <TextView android:id="@+id/tvVideoAvailability" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="차량 영상 실행 불가 · 공식 주차 상태 확인 및 승인된 앱 연동 필요"
                android:textColor="#F6CD8A" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="휴대폰에서 해당 앱을 직접 이용하세요. 차량 화면으로 전송하거나 주행 중 시청하지 마세요."
                android:textColor="#A8BAC6" android:textSize="12sp" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:text="프라이버시 시연" android:textColor="#F5F8FA"
            android:textSize="20sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:padding="14dp" android:orientation="vertical"
            android:background="@drawable/console_card">
            <TextView android:id="@+id/tvCameraConsentStatus" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:textSize="15sp" android:textColor="#F5F8FA"
                android:accessibilityLiveRegion="polite" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:textSize="12sp" android:textColor="#A8BAC6"
                android:text="실제 촬영·전송 없음 · 웹과 동기화되지 않으며 차주에게 전달되지 않습니다" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCameraOptIn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                    android:minWidth="0dp" android:text="동의 시연 켜기" app:cornerRadius="14dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnCameraRevoke"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="56dp"
                    android:minWidth="0dp" android:text="동의 철회" app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCompleteRest"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="20dp"
            android:text="시연 종료 · 상태 초기화" app:cornerRadius="16dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center"
            android:text="PLEOS  /  LOCAL EXPERIENCE PREVIEW" android:textColor="#748B9A"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
