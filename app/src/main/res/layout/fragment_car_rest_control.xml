<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="차량 콘솔 로컬 시연 · 차량 SDK, 예약 및 주차 상태 확인 기능이 없습니다. 주행 중 사용하지 마세요."
            android:textColor="#FFDA9B" android:textSize="20sp" />
        <TextView android:id="@+id/tvRestTimer" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:textColor="#FFFFFF" android:textSize="24sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStartPreview"
            android:layout_width="match_parent" android:layout_height="60dp" android:text="로컬 시연 시작 (실제 이용 아님)" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTempMinus"
                android:layout_width="64dp" android:layout_height="64dp" android:text="−" android:contentDescription="모의 온도 낮추기" />
            <TextView android:id="@+id/tvCurrentTemp" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center"
                android:textColor="#FFFFFF" android:textSize="22sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnTempPlus"
                android:layout_width="64dp" android:layout_height="64dp" android:text="+" android:contentDescription="모의 온도 높이기" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSeatHeating"
            android:layout_width="match_parent" android:layout_height="60dp" android:text="시트 열선 모의 조작" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSeatVentilation"
            android:layout_width="match_parent" android:layout_height="60dp" android:text="시트 통풍 모의 조작" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRelaxSeat"
            android:layout_width="match_parent" android:layout_height="60dp" android:text="시트 자세 모의 조작" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnWindow"
            android:layout_width="match_parent" android:layout_height="60dp" android:text="창문 조작 불가 · 공식 SDK 필요" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMedia"
            android:layout_width="match_parent" android:layout_height="60dp" android:text="미디어 이용 불가 · 주차 상태 확인 필요" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:textSize="20sp" android:textColor="#FFDA9B"
            android:text="실내 카메라 동의 시연 · 실제 촬영/전송 없음" />
        <TextView android:id="@+id/tvCameraConsentStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="18sp" android:textColor="#FFFFFF"
            android:accessibilityLiveRegion="polite" android:text="고객 동의 시연: 꺼짐 · 촬영 및 전송 없음 · 차주 접근 불가" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:text="고객이 직접 선택하는 이 기기 내 상태 표시입니다. 웹과 동기화되지 않으며 차주에게 영상이나 동의 상태가 전달되지 않습니다. 언제든 철회할 수 있습니다." />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCameraOptIn"
            android:layout_width="match_parent" android:layout_height="60dp" android:text="고객 동의 시연 켜기 (영상 연결 안 됨)" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCameraRevoke"
            android:layout_width="match_parent" android:layout_height="60dp" android:text="동의 즉시 철회" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCompleteRest"
            android:layout_width="match_parent" android:layout_height="60dp" android:text="로컬 시연 종료 및 동의 철회" />
    </LinearLayout>
</ScrollView>
